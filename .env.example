# Backend API Configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Supabase Storage (bucket privado de documentos del animal)
NEXT_PUBLIC_SUPABASE_BUCKET_ANIMAL_DOCS=animal_docs
