{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "git:policy": "node tooling/git-policy.mjs",
    "git:workflows": "node tooling/security-tools.mjs actionlint && node tooling/git-policy.mjs --verify-workflows",
    "git:tools": "node tooling/security-tools.mjs actionlint",
    "git:setup-hooks": "node tooling/install-hooks.mjs",
    "test:policy": "node --test tooling/tests/*.test.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "openapi:generate": "openapi-typescript lib/api/openapi.json -o lib/api/openapi.generated.d.ts",
    "openapi:check": "openapi-typescript lib/api/openapi.json -o lib/api/openapi.generated.d.ts --check"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.0.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "pnpm": {
    "overrides": {
      "source-map-js": "1.2.2"
    }
  }
}
